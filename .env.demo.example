# EXNESS DEMO TEMPLATE - copy to .env (setup_demo.ps1 does this) and fill the blanks.
# DEMO broker orders ONLY: the MT5 terminal itself must report a DEMO account; REAL/LIVE stay locked.
# Never commit or paste your .env. Keys/passwords live only in .env.

# SAFETY: live is refused. Startup is paused, reconciles first, then autonomy needs every safety gate and AI health.
BACKTEST_MODE=false
DEMO_MODE=true
LIVE_TRADING=false
PAPER_TRADING=false
START_PAUSED=true
AUTONOMOUS_DEMO=true
AUTO_RESUME_MAX_PER_DAY=3
MT5_BACKEND=real
# Keep stage evidence enabled; fast-track remains off.

# MT5 terminal (logged in to your Exness DEMO account). Leave all three blank to use its login.
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# USD for a standard demo; USC for a cent demo (the bot converts cents automatically).
ACCOUNT_CURRENCY=USD

# Markets (broker suffixes such as XAUUSDm are detected by python -m scripts.resolve_symbols).
SYMBOLS=XAUUSD,EURUSD,GBPUSD
SYMBOL_ALIASES_JSON={}
PRIMARY_TIMEFRAME=M5
HIGHER_TIMEFRAME=M15
TREND_TIMEFRAME=H1
TRADING_DAY_TIMEZONE=UTC
MAX_RISK_PERCENT_PER_TRADE=0.5

# Optional Telegram reports only. These fields never enable controls; invalid/missing values disable remote delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=
REPORT_LANGUAGE=en

# AI (Groq). Every entry needs a valid AI approval; no AI answer => no trade.
AI_PROVIDER=openai_compatible
AI_FALLBACK_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_FAST=qwen/qwen3.8-27b
OPENAI_MODEL_DEEP=openai/gpt-oss-120b
OPENAI_RESPONSE_FORMAT=json_schema_strict
AI_REQUIRE_APPROVAL=true
AI_RULE_FALLBACK_ENABLED=false
AI_DECISION_MODE=first_available
# Second AI key (optional): see docs/DEMO_QUICKSTART.md. Leave [] for the single Groq key above.
AI_PROVIDERS=[]

# NEWS: free FXStreet headlines + free weekly economic calendar (verify with
# python -m scripts.inspect_news_sources --fetch). News unavailable => no new trades (block).
USE_FREE_NEWS_SOURCES=true
USE_RSS=true
USE_ECONOMIC_CALENDAR=true
BLOCK_TRADING_HIGH_IMPACT_NEWS=true
RSS_URLS_JSON=["https://www.fxstreet.com/rss/news"]
NEWS_SOURCE_COVERAGE_JSON={"rss-f2f922e82b892978":{"symbols":["XAUUSD","EURUSD","GBPUSD"],"currencies":["USD","EUR","GBP"],"reviewed":true,"realtime":true,"language":"en","poll_seconds":180,"max_publication_lag_seconds":3600}}
CALENDAR_PROVIDER=faireconomy
CALENDAR_FAIRECONOMY_REVIEWED=true
NEWS_UNAVAILABLE_POLICY=block

# Storage
DATABASE_URL=sqlite:///data/reflexbot.db
DATA_DIR=data
LOG_FILE=data/logs/bot.log
BACKUP_DIR=data/backups
