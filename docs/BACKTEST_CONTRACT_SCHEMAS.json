{
  "version": "0.11.0",
  "schema_version": 2,
  "not_data_or_stage_evidence": true,
  "additional_runtime_checks": "UTC/grid/currency/alias/hash/chronology/size/session/source/policy/code/causal-model/reconstruction guards remain mandatory",
  "dataset_manifest": {
    "$defs": {
      "HistoricalSpec": {
        "additionalProperties": false,
        "properties": {
          "logical_symbol": {
            "pattern": "^[A-Za-z0-9_.#-]{1,64}$",
            "title": "Logical Symbol",
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z0-9_.#-]{1,64}$",
            "title": "Name",
            "type": "string"
          },
          "point": {
            "title": "Point",
            "type": "string"
          },
          "tick_size": {
            "title": "Tick Size",
            "type": "string"
          },
          "contract_size": {
            "title": "Contract Size",
            "type": "string"
          },
          "volume_min": {
            "title": "Volume Min",
            "type": "string"
          },
          "volume_max": {
            "title": "Volume Max",
            "type": "string"
          },
          "volume_step": {
            "title": "Volume Step",
            "type": "string"
          },
          "digits": {
            "maximum": 12,
            "minimum": 0,
            "title": "Digits",
            "type": "integer"
          },
          "currency_base": {
            "pattern": "^[A-Z0-9]{3,8}$",
            "title": "Currency Base",
            "type": "string"
          },
          "currency_profit": {
            "pattern": "^[A-Z0-9]{3,8}$",
            "title": "Currency Profit",
            "type": "string"
          },
          "tick_value_profit": {
            "default": "0",
            "title": "Tick Value Profit",
            "type": "string"
          },
          "tick_value_loss": {
            "default": "0",
            "title": "Tick Value Loss",
            "type": "string"
          },
          "stops_level": {
            "default": 0,
            "maximum": 100000,
            "minimum": 0,
            "title": "Stops Level",
            "type": "integer"
          },
          "freeze_level": {
            "default": 0,
            "maximum": 100000,
            "minimum": 0,
            "title": "Freeze Level",
            "type": "integer"
          },
          "trade_mode": {
            "default": 4,
            "maximum": 4,
            "minimum": 0,
            "title": "Trade Mode",
            "type": "integer"
          },
          "profit_model": {
            "const": "linear_contract",
            "default": "linear_contract",
            "title": "Profit Model",
            "type": "string"
          },
          "margin_model": {
            "default": "notional",
            "enum": [
              "notional",
              "forex_base"
            ],
            "title": "Margin Model",
            "type": "string"
          },
          "effective_from": {
            "format": "date-time",
            "title": "Effective From",
            "type": "string"
          },
          "description": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "logical_symbol",
          "name",
          "point",
          "tick_size",
          "contract_size",
          "volume_min",
          "volume_max",
          "volume_step",
          "digits",
          "currency_base",
          "currency_profit",
          "effective_from",
          "description"
        ],
        "title": "HistoricalSpec",
        "type": "object"
      },
      "LocalFile": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "title": "LocalFile",
        "type": "object"
      },
      "Origin": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "synthetic_fixture",
              "historical_import"
            ],
            "title": "Kind",
            "type": "string"
          },
          "description": {
            "maxLength": 1200,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "provider": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "acquired_at": {
            "format": "date-time",
            "title": "Acquired At",
            "type": "string"
          },
          "license_note": {
            "maxLength": 512,
            "minLength": 1,
            "title": "License Note",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "description",
          "provider",
          "acquired_at",
          "license_note"
        ],
        "title": "Origin",
        "type": "object"
      },
      "ReplayModelSelection": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "reflex-replay-model-selection-v1",
            "title": "Format",
            "type": "string"
          },
          "purpose": {
            "const": "research_only",
            "title": "Purpose",
            "type": "string"
          },
          "description": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "available_at": {
            "format": "date-time",
            "title": "Available At",
            "type": "string"
          },
          "selected_at": {
            "format": "date-time",
            "title": "Selected At",
            "type": "string"
          },
          "artifact": {
            "$ref": "#/$defs/LocalFile"
          },
          "learning_dataset": {
            "$ref": "#/$defs/LocalFile"
          }
        },
        "required": [
          "format",
          "purpose",
          "description",
          "available_at",
          "selected_at",
          "artifact",
          "learning_dataset"
        ],
        "title": "ReplayModelSelection",
        "type": "object"
      },
      "SessionInterval": {
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "pattern": "^[A-Za-z0-9_.#-]{1,64}$",
            "title": "Symbol",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "start",
          "end"
        ],
        "title": "SessionInterval",
        "type": "object"
      },
      "SymbolFile": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "symbol": {
            "pattern": "^[A-Za-z0-9_.#-]{1,64}$",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "symbol"
        ],
        "title": "SymbolFile",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "reflex-history-v1",
        "title": "Format",
        "type": "string"
      },
      "origin": {
        "$ref": "#/$defs/Origin"
      },
      "quote_mode": {
        "enum": [
          "ticks",
          "ohlc_conservative"
        ],
        "title": "Quote Mode",
        "type": "string"
      },
      "account_currency": {
        "pattern": "^[A-Z0-9]{3,8}$",
        "title": "Account Currency",
        "type": "string"
      },
      "replay_from": {
        "format": "date-time",
        "title": "Replay From",
        "type": "string"
      },
      "replay_until": {
        "format": "date-time",
        "title": "Replay Until",
        "type": "string"
      },
      "symbols": {
        "items": {
          "$ref": "#/$defs/HistoricalSpec"
        },
        "maxItems": 40,
        "minItems": 1,
        "title": "Symbols",
        "type": "array"
      },
      "bars": {
        "items": {
          "$ref": "#/$defs/SymbolFile"
        },
        "maxItems": 40,
        "minItems": 1,
        "title": "Bars",
        "type": "array"
      },
      "ticks": {
        "default": [],
        "items": {
          "$ref": "#/$defs/SymbolFile"
        },
        "maxItems": 40,
        "title": "Ticks",
        "type": "array"
      },
      "sessions": {
        "items": {
          "$ref": "#/$defs/SessionInterval"
        },
        "maxItems": 4096,
        "minItems": 1,
        "title": "Sessions",
        "type": "array"
      },
      "news": {
        "anyOf": [
          {
            "$ref": "#/$defs/LocalFile"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "reviews": {
        "anyOf": [
          {
            "$ref": "#/$defs/LocalFile"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "model": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReplayModelSelection"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "format",
      "origin",
      "quote_mode",
      "account_currency",
      "replay_from",
      "replay_until",
      "symbols",
      "bars",
      "sessions"
    ],
    "title": "DatasetManifest",
    "type": "object"
  },
  "options": {
    "additionalProperties": false,
    "properties": {
      "review_mode": {
        "default": "veto",
        "enum": [
          "veto",
          "archive",
          "synthetic_research"
        ],
        "title": "Review Mode",
        "type": "string"
      },
      "max_events": {
        "default": 500000,
        "maximum": 500000,
        "minimum": 1,
        "title": "Max Events",
        "type": "integer"
      },
      "close_at_end": {
        "default": false,
        "title": "Close At End",
        "type": "boolean"
      },
      "simulate_orders": {
        "default": false,
        "title": "Simulate Orders",
        "type": "boolean"
      }
    },
    "title": "BacktestOptions",
    "type": "object"
  },
  "news_archive": {
    "$defs": {
      "ArchivedEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Event Id",
            "type": "string"
          },
          "known_at": {
            "format": "date-time",
            "title": "Known At",
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "title": "Scheduled At",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "title": "Impact",
            "type": "string"
          },
          "precise_time": {
            "default": true,
            "title": "Precise Time",
            "type": "boolean"
          }
        },
        "required": [
          "event_id",
          "known_at",
          "scheduled_at",
          "currency",
          "impact"
        ],
        "title": "ArchivedEvent",
        "type": "object"
      },
      "ArchivedHeadline": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 1000,
            "title": "Summary",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "first_seen_at": {
            "format": "date-time",
            "title": "First Seen At",
            "type": "string"
          },
          "currencies": {
            "default": [],
            "items": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            "title": "Currencies",
            "type": "array"
          },
          "instruments": {
            "default": [],
            "items": {
              "pattern": "^[A-Z0-9]{2,10}$",
              "type": "string"
            },
            "title": "Instruments",
            "type": "array"
          },
          "language": {
            "default": "en",
            "enum": [
              "en",
              "unsupported"
            ],
            "title": "Language",
            "type": "string"
          },
          "impact": {
            "default": "unknown",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "title": "Impact",
            "type": "string"
          }
        },
        "required": [
          "title",
          "published_at",
          "first_seen_at"
        ],
        "title": "ArchivedHeadline",
        "type": "object"
      },
      "ArchivedNewsSnapshot": {
        "additionalProperties": false,
        "properties": {
          "available_at": {
            "format": "date-time",
            "title": "Available At",
            "type": "string"
          },
          "headlines_fetched_at": {
            "format": "date-time",
            "title": "Headlines Fetched At",
            "type": "string"
          },
          "calendar_fetched_at": {
            "format": "date-time",
            "title": "Calendar Fetched At",
            "type": "string"
          },
          "covered_from": {
            "format": "date-time",
            "title": "Covered From",
            "type": "string"
          },
          "covered_until": {
            "format": "date-time",
            "title": "Covered Until",
            "type": "string"
          },
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Symbols",
            "type": "array"
          },
          "headlines": {
            "default": [],
            "items": {
              "$ref": "#/$defs/ArchivedHeadline"
            },
            "maxItems": 1000,
            "title": "Headlines",
            "type": "array"
          },
          "events": {
            "default": [],
            "items": {
              "$ref": "#/$defs/ArchivedEvent"
            },
            "maxItems": 1000,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "available_at",
          "headlines_fetched_at",
          "calendar_fetched_at",
          "covered_from",
          "covered_until",
          "complete",
          "symbols"
        ],
        "title": "ArchivedNewsSnapshot",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "reflex-replay-news-v1",
        "title": "Format",
        "type": "string"
      },
      "snapshots": {
        "items": {
          "$ref": "#/$defs/ArchivedNewsSnapshot"
        },
        "maxItems": 4096,
        "title": "Snapshots",
        "type": "array"
      }
    },
    "required": [
      "format",
      "snapshots"
    ],
    "title": "NewsArchive",
    "type": "object"
  },
  "review_archive": {
    "$defs": {
      "ArchivedEntryReview": {
        "additionalProperties": false,
        "properties": {
          "available_at": {
            "format": "date-time",
            "title": "Available At",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "proposal_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Proposal Hash",
            "type": "string"
          },
          "news_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "News Hash",
            "type": "string"
          },
          "code_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Code Hash",
            "type": "string"
          },
          "model_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Model Sha256",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject",
              "wait"
            ],
            "title": "Decision",
            "type": "string"
          },
          "confidence": {
            "maximum": 100,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "risk_percent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Risk Percent"
          },
          "original_provider": {
            "enum": [
              "ollama",
              "openai"
            ],
            "title": "Original Provider",
            "type": "string"
          },
          "provider_model": {
            "pattern": "^[A-Za-z0-9_./:@+-]{1,128}$",
            "title": "Provider Model",
            "type": "string"
          },
          "request_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Hash",
            "type": "string"
          }
        },
        "required": [
          "available_at",
          "observed_at",
          "proposal_hash",
          "news_hash",
          "code_hash",
          "model_sha256",
          "decision",
          "confidence",
          "original_provider",
          "provider_model",
          "request_hash"
        ],
        "title": "ArchivedEntryReview",
        "type": "object"
      },
      "ArchivedPositionReview": {
        "additionalProperties": false,
        "properties": {
          "available_at": {
            "format": "date-time",
            "title": "Available At",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "logical_symbol": {
            "pattern": "^[A-Za-z0-9_.#-]{1,64}$",
            "title": "Logical Symbol",
            "type": "string"
          },
          "position_identifier": {
            "exclusiveMinimum": 0,
            "title": "Position Identifier",
            "type": "integer"
          },
          "position_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Position Hash",
            "type": "string"
          },
          "code_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Code Hash",
            "type": "string"
          },
          "model_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Model Sha256",
            "type": "string"
          },
          "news_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "News Hash",
            "type": "string"
          },
          "confidence": {
            "maximum": 100,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "momentum_continues": {
            "title": "Momentum Continues",
            "type": "boolean"
          },
          "volatility_safe": {
            "title": "Volatility Safe",
            "type": "boolean"
          },
          "original_provider": {
            "enum": [
              "ollama",
              "openai"
            ],
            "title": "Original Provider",
            "type": "string"
          }
        },
        "required": [
          "available_at",
          "observed_at",
          "logical_symbol",
          "position_identifier",
          "position_hash",
          "code_hash",
          "model_sha256",
          "news_hash",
          "confidence",
          "momentum_continues",
          "volatility_safe",
          "original_provider"
        ],
        "title": "ArchivedPositionReview",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "reflex-replay-reviews-v1",
        "title": "Format",
        "type": "string"
      },
      "description": {
        "maxLength": 1024,
        "minLength": 1,
        "title": "Description",
        "type": "string"
      },
      "entries": {
        "items": {
          "$ref": "#/$defs/ArchivedEntryReview"
        },
        "maxItems": 20000,
        "title": "Entries",
        "type": "array"
      },
      "position_entries": {
        "default": [],
        "items": {
          "$ref": "#/$defs/ArchivedPositionReview"
        },
        "maxItems": 20000,
        "title": "Position Entries",
        "type": "array"
      }
    },
    "required": [
      "format",
      "description",
      "entries"
    ],
    "title": "ReviewArchive",
    "type": "object"
  },
  "replay_model_selection": {
    "$defs": {
      "LocalFile": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "title": "LocalFile",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "reflex-replay-model-selection-v1",
        "title": "Format",
        "type": "string"
      },
      "purpose": {
        "const": "research_only",
        "title": "Purpose",
        "type": "string"
      },
      "description": {
        "maxLength": 1024,
        "minLength": 1,
        "title": "Description",
        "type": "string"
      },
      "available_at": {
        "format": "date-time",
        "title": "Available At",
        "type": "string"
      },
      "selected_at": {
        "format": "date-time",
        "title": "Selected At",
        "type": "string"
      },
      "artifact": {
        "$ref": "#/$defs/LocalFile"
      },
      "learning_dataset": {
        "$ref": "#/$defs/LocalFile"
      }
    },
    "required": [
      "format",
      "purpose",
      "description",
      "available_at",
      "selected_at",
      "artifact",
      "learning_dataset"
    ],
    "title": "ReplayModelSelection",
    "type": "object"
  }
}
