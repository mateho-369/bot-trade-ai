# MT5 AI ReflexBot — fail-closed defaults. Copy to .env; never commit .env.
# MODE: four mutually exclusive outcomes (see README mode matrix)
BACKTEST_MODE=false
DEMO_MODE=true
LIVE_TRADING=false
PAPER_TRADING=true
START_PAUSED=true
MT5_BACKEND=mock

# MT5: real integration runs on Windows in the logged-on user's session.
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# Leave ALL THREE empty to attach to the terminal's existing login.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=20260217
MT5_CONNECT_TIMEOUT_MS=10000
MT5_RECONNECT_ATTEMPTS=3
MT5_RECONNECT_BACKOFF_SECONDS=5
MAX_TICK_AGE_SECONDS=10
MAX_CANDLE_AGE_SECONDS=420
MT5_API_TIMEOUT_SECONDS=45
ORDER_MAX_AGE_SECONDS=30

# SIMULATION: synthetic/paper capital is NOT the actual broker balance.
PAPER_INITIAL_BALANCE=1000
PAPER_SLIPPAGE_POINTS=2
MOCK_LEVERAGE=100
# Managed shadow state: missing/corrupt checkpoint NEVER resets capital.
PAPER_STATE_FILE=data/paper/state.json
# One DB-backed runtime lease, independently renewed; restart ALWAYS paused.
RUNTIME_LEASE_SECONDS=90
RISK_OBSERVATION_MAX_AGE_SECONDS=30

# ACCOUNT RISK: percentages are percentage points, not fractions.
# Must equal the terminal's account currency (the bot refuses a mismatch).
# Exness CENT account: ACCOUNT_CURRENCY=USC (or EUC). 100 USC = 1 USD exactly:
# balances, risk budgets and lot valuations stay in cents, USD targets/commission
# are converted x100 automatically (a $2 target = 200 USC). With USC also set
# PAPER_INITIAL_BALANCE in cents (100000 = $1,000). scripts.resolve_symbols
# detects the terminal currency and proposes this value.
ACCOUNT_CURRENCY=USD
MAX_RISK_PERCENT_PER_TRADE=0.5
LIVE_MAX_RISK_PERCENT_PER_TRADE=0.1
MAX_TOTAL_OPEN_RISK_PERCENT=1.5
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=10
MAX_MARGIN_USAGE_PERCENT=30
MAX_DAILY_TRADES=12
MIN_DAILY_TRADES_TARGET=6
MAX_OPEN_POSITIONS=3
MAX_SAME_SYMBOL_POSITIONS=1
MAX_SPREAD_POINTS=35
# Broker POINTS, not pips. Missing symbols use MAX_SPREAD_POINTS. Run
# scripts.resolve_symbols --write to set per-instrument caps from the broker's own
# typical spread x2 (e.g. BTCUSD needs thousands of points, EURUSD a few).
SYMBOL_SPREAD_LIMITS_JSON={}
MAX_SLIPPAGE_POINTS=10
MIN_SIGNAL_SCORE=70
REQUIRE_STOP_LOSS=true
MIN_NET_REWARD_RISK=1.1
TRADING_DAY_TIMEZONE=UTC

# PROFIT TARGET: an objective, not guaranteed profit or a sizing instruction.
TARGET_PROFIT_USD_PER_TRADE=5
USE_DYNAMIC_TARGET=true
TARGET_R_MULTIPLE=1.1
# Replace these estimates with your broker's actual costs before evaluation.
COMMISSION_ROUND_TURN_USD_PER_LOT=7
ESTIMATED_SWAP_USD_PER_LOT_PER_DAY=0

# TRADING SYMBOLS: ANY logical names your broker offers (FX, metals, crypto,
# indices). Broker suffixes (XAUUSDm, XAUUSDc, EURUSD.raw, US30-ecn) are detected by
#   python -m scripts.resolve_symbols --env-file .env --write
# which reads the terminal's Market Watch read-only and writes the aliases, spread
# caps, news currencies and FX route below. Explicit entries you add always win.
SYMBOLS=XAUUSD,BTCUSD,EURUSD,GBPUSD,ETHUSD
SYMBOL_ALIASES_JSON={}
# Unknown news exposure blocks new entries; resolve_symbols infers fiat exposure.
SYMBOL_NEWS_CURRENCIES_JSON={"XAUUSD":["USD"],"BTCUSD":["USD"],"ETHUSD":["USD"],"EURUSD":["EUR","USD"],"GBPUSD":["GBP","USD"],"US30":["USD"],"NAS100":["USD"]}
# Used only when account (parent) currency is not USD, e.g. {"EUR":"EURUSDc"} for EUC.
ACCOUNT_TO_USD_SYMBOLS_JSON={}

# TIMEFRAMES: closed bars only; H1 bias is aligned as-of the decision time.
PRIMARY_TIMEFRAME=M5
HIGHER_TIMEFRAME=M15
TREND_TIMEFRAME=H1
CANDLE_LOOKBACK=300

# STRATEGIES: explicit owner-reviewed weights, no silent normalization/adaptation.
# All four keys required; zero disables a strategy. Total must be exactly 1.
STRATEGY_WEIGHTS_JSON={"trend":0.30,"mean_reversion":0.25,"breakout":0.20,"momentum":0.25}
STRATEGY_MIN_AGREEING=2
STRATEGY_MIN_COVERAGE=0.50
STRATEGY_MIN_AGREEMENT=0.80
STRATEGY_MIN_VOTE_SCORE=60
STRATEGY_STOP_ATR_MULTIPLIER=1.8
# No chasing a quote further than this ATR distance from the finalized close.
STRATEGY_MAX_ENTRY_DRIFT_ATR=0.5
# Last three history intervals checked; no interpolation over market gaps.
STRATEGY_MAX_RECENT_GAP_BARS=3
VOLATILITY_MIN_ATR_PERCENT=0.01
VOLATILITY_MAX_ATR_PERCENT=2
VOLATILITY_MAX_ATR_SHOCK=2
VOLATILITY_MAX_BAR_ATR_RATIO=3
VOLATILITY_MAX_SPREAD_ATR_RATIO=0.15

# PROFIT-LOCK TRAILING: trigger percent : desired locked target percent.
TRAILING_LEVELS=30:30,60:60,90:90
TRAILING_SPREAD_BUFFER_POINTS=2
ATR_TRAILING_ENABLED=true
ATR_TRAILING_MULTIPLIER=1.5
ALLOW_TP_EXTENSION=false
TP_EXTENSION_FACTOR=1.2

# TELEGRAM: configure BOTH token and owner ID, or leave both empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_MINIAPP_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=300
TELEGRAM_INITDATA_MAX_BYTES=8192
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=5
TELEGRAM_COMMAND_MAX_AGE_SECONDS=60
OWNER_CONFIRMATION_TTL_SECONDS=45
OWNER_MAX_PENDING_CONFIRMATIONS=64
# Webhook secrets, when used, need 32+ random allowed characters; never a URL token.
# Polling is default; webhook and polling must never run simultaneously.
TELEGRAM_USE_WEBHOOK=false

# API: loopback default; expose only through a TLS reverse proxy/tunnel.
API_HOST=127.0.0.1
API_PORT=8000
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_REQUEST_BYTES=16384
API_MAX_HEADER_BYTES=16384
API_SAFE_STOP_RATE_PER_MINUTE=10
API_MAX_RATE_LIMIT_KEYS=2048
# Add the exact public HTTPS hostname when using a TLS proxy (no unrestricted *).
API_TRUSTED_HOSTS_JSON=["127.0.0.1","localhost"]
# An empty allowlist means no cross-origin browser API access.
API_CORS_ORIGINS_JSON=[]
# Only these exact ASGI peer IPs may attest X-Forwarded-Proto: https.
# Uvicorn proxy_headers remains OFF; forwarded client IP/host are NEVER trusted.
# Bind API to loopback and overwrite this header in the controlled TLS proxy.
API_TRUSTED_PROXY_IPS_JSON=["127.0.0.1","::1"]

# AI: Groq via its OpenAI-compatible API. AI_PROVIDER=openai_compatible (aliases: openai, groq) is
# the adapter TYPE, not the vendor.
# Put your Groq key in OPENAI_API_KEY in your private .env only; never commit or paste it in chat.
# Strict mode = Groq constrained decoding (supported: qwen/qwen3.8-27b, openai/gpt-oss-20b,
# openai/gpt-oss-120b). Every reply is ALSO strictly validated and hash-bound locally.
# For gpt-oss set OPENAI_REASONING_EFFORT=low and AI_MAX_OUTPUT_TOKENS=2048 (reasoning uses tokens).
# Empty OPENAI_REASONING_EFFORT = parameter not sent (Qwen default returns no reasoning tokens).
AI_PROVIDER=openai_compatible
AI_FALLBACK_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ALLOW_REMOTE_OLLAMA=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Fast model: entries, trailing, config review (OPENAI_MODEL is an accepted alias).
OPENAI_MODEL_FAST=qwen/qwen3.8-27b
# Deep model: nightly review and learning (AI_DEEP_MODEL is an accepted alias).
OPENAI_MODEL_DEEP=openai/gpt-oss-120b
OPENAI_RESPONSE_FORMAT=json_schema_strict
OPENAI_REASONING_EFFORT=
# AI FALLBACK MODE (owner-controlled; switch at runtime with /ai_fallback_block,
# /ai_fallback_technical, /ai_fallback_status or Mini App Settings; every change is audited).
# When the AI times out, is rate-limited (429), down (5xx), unconfigured (no key) or returns invalid
# JSON after AI_MAX_RETRIES retries:
#   BLOCK_ON_AI_FAILURE (default, safest) => NO new entries; trailing locks/protection continue.
#   TECHNICAL_ONLY => the local technical score decides; approves only at
#   >= AI_RULE_FALLBACK_MIN_SCORE (must be >= AI_CONFIDENCE_THRESHOLD and MIN_SIGNAL_SCORE).
# A VALID AI reject/WAIT/low confidence is final and never overruled. News, ML filter, risk, stage,
# owner pause/kill and SL gates apply in both modes. Never used in BACKTEST. TECHNICAL_ONLY in
# LIVE needs the separate explicit opt-in below.
# NOTE: with no OPENAI_API_KEY and BLOCK_ON_AI_FAILURE the bot opens NO trades (by design).
AI_FALLBACK_MODE=BLOCK_ON_AI_FAILURE
AI_MAX_RETRIES=3
AI_RULE_FALLBACK_ENABLED=true
AI_RULE_FALLBACK_MIN_SCORE=80
AI_RULE_FALLBACK_ALLOW_LIVE=false
AI_CONFIDENCE_THRESHOLD=70
AI_TIMEOUT_SECONDS=10
AI_MAX_CONCURRENT=2
AI_POSITION_REVIEW_SECONDS=300
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_OUTPUT_TOKENS=768
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_SUGGESTION_TTL_SECONDS=3600
AUTO_REDUCE_RISK=false
# --- AI-FIRST brain (docs/AI_FIRST_ARCHITECTURE.md) -------------------------------------------
# The AI is consulted before every entry and after every profit lock; it can only ADD vetoes or
# REDUCE risk (set AUTO_REDUCE_RISK=true to let it shrink size). Outage => AI_FALLBACK_MODE above.
AI_FIRST_ENABLED=true
# Reuse identical minute-bucketed market answers (0-120 s) and space requests (rate limits/429).
AI_DECISION_CACHE_SECONDS=90
AI_QUEUE_MIN_INTERVAL_MS=500
# Lock-first trailing (docs/TRAILING_AI_DESIGN.md): mechanical 30/60/90 lock ALWAYS first, then AI
# (hold / close_now / tighten / extend). AI slower than this => mechanical rules continue.
AI_ADAPTIVE_TRAILING_ENABLED=true
AI_TRAILING_TIMEOUT_SECONDS=2
# AI-DYNAMIC LIMITS (two layers). Layer 1, AI-adjustable: MAX_DAILY_TRADES 6-20, MAX_OPEN_POSITIONS
# 1-5, risk 0.1-1.0 %, target $1-20 (the values above are the owner DEFAULTS used whenever the AI is
# unavailable). Increases only in a strong trend (ADX >= 25, news risk not high); choppy/high-news
# markets can only reduce. Changes > 50 % vs the default wait for /approve. Layer 2, hard caps in
# code: 25 trades/day, 5 positions, 1.0 % risk; daily loss 3 % / drawdown 10 % auto-pause.
# /ai_reset or Mini App "Reset AI to defaults" reverts everything. false = static owner values.
AI_DYNAMIC_LIMITS_ENABLED=true
AI_CONFIG_AUTO_APPLY_MINOR=true
AUTO_ADAPT_STRATEGY_WEIGHTS=false
MAX_STRATEGY_WEIGHT_STEP=0.02

# NEWS: headlines are NOT a substitute for an economic calendar.
NEWS_API_KEY=
FINNHUB_API_KEY=
CRYPTOPANIC_API_KEY=
USE_FREE_NEWS_SOURCES=true
USE_RSS=true
USE_ECONOMIC_CALENDAR=true
BLOCK_TRADING_HIGH_IMPACT_NEWS=true
NEWS_IMPACT_THRESHOLD=high
NEWS_REQUIRED_FOR_ENTRY=true
# Supply feeds you are entitled to use; unavailable feeds stay unavailable.
RSS_URLS_JSON=[]
CALENDAR_SOURCE_URL=
CALENDAR_FILE=data/news/calendar.json
NEWS_POLL_SECONDS=180
NEWS_MAX_AGE_SECONDS=900
CALENDAR_MAX_AGE_SECONDS=21600
NEWS_PRE_EVENT_MINUTES=30
NEWS_POST_EVENT_MINUTES=15

# Optional licensed APIs: keys alone do NOT enable a provider. Defaults make no calls.
NEWSAPI_ENABLED=false
NEWSAPI_ACCESS_MODE=development
NEWSAPI_QUERY=forex OR central bank OR inflation OR gold OR bitcoin OR ethereum
FINNHUB_NEWS_ENABLED=false
FINNHUB_NEWS_CATEGORIES_JSON=["forex","general","crypto"]
CRYPTOPANIC_ENABLED=false
CRYPTOPANIC_PLAN=developer
CRYPTOPANIC_CURRENCIES_JSON=["BTC","ETH"]
# Review source IDs with python -m scripts.inspect_news_sources (no HTTP).
# Owner scope/realtime/entitlement declarations are not independent data attestation.
# Empty policies or missing currencies => diagnostic/alerts only, never safe entry.
NEWS_SOURCE_COVERAGE_JSON={}
# Empty => every configured source relevant to that symbol is mandatory.
NEWS_REQUIRED_SOURCE_IDS_JSON=[]
NEWS_HTTP_TIMEOUT_SECONDS=8
NEWS_REFRESH_TIMEOUT_SECONDS=30
NEWS_HTTP_MAX_BYTES=1048576
NEWS_MAX_ITEMS_PER_SOURCE=200
NEWS_MAX_TOTAL_ITEMS=500
NEWS_MAX_PAGES=3
NEWS_MAX_CONCURRENT=3
NEWS_REQUEST_SPACING_SECONDS=1
NEWS_HEADLINE_BLOCK_MINUTES=60
NEWS_SNAPSHOT_MAX_BYTES=1048576
NEWS_SNAPSHOT_MAX_FILES=50000
NEWS_ALERTS_PER_REFRESH=10
# auto chooses configured normalized JSON HTTPS URL, otherwise reviewed local file.
# Never scrape a website or infer complete coverage from a bare event/news array.
CALENDAR_PROVIDER=auto
CALENDAR_FILE_REVIEWED=false
CALENDAR_ALLOW_EMPTY_REVIEWED=false
FINNHUB_CALENDAR_SCOPE_REVIEWED=false
FINNHUB_CALENDAR_TIMEZONE=UTC
CALENDAR_LOOKBACK_HOURS=24
CALENDAR_LOOKAHEAD_HOURS=48

# LEARNING + PROMOTION: owner approval is still required after these gates.
REQUIRE_STAGE_GATES=true
MODEL_MIN_LABELLED_TRADES=300
MODEL_WALK_FORWARD_FOLDS=5
MODEL_LABEL_HORIZON_BARS=12
MODEL_EMBARGO_BARS=12
# Logistic baseline and native-text LightGBM are real training options; no pickle.
MODEL_ALGORITHM=logistic
# Off by default; enabling requires an owner-selected matching staged artifact.
# Enabled HISTORICAL approval replay additionally requires one frozen model/corpus
# manifest binding and exact pre-replay reconstruction. No production activation.
# See docs/ML_REPLAY.md; NEVER disable a configured filter just to make a replay trade.
MODEL_FILTER_ENABLED=false
MODEL_MIN_PROBABILITY=0.70
MODEL_MIN_EVAL_AUC=0.55
MODEL_MIN_BRIER_SKILL=0.01
MODEL_MIN_SELECTED_TEST_TRADES=30
MODEL_MAX_DATASET_ROWS=10000
MODEL_MAX_ARTIFACT_BYTES=1048576
MODEL_MAX_AGE_DAYS=30
MODEL_RANDOM_SEED=42
STAGE_MIN_PAPER_DAYS=14
STAGE_MIN_DEMO_DAYS=14
STAGE_MIN_TRADES=100
STAGE_MIN_PROFIT_FACTOR=1.1
STAGE_MAX_DRAWDOWN_PERCENT=5
LIVE_APPROVAL_TTL_SECONDS=3600

# DATABASE: PostgreSQL requires the optional psycopg driver.
DATABASE_URL=sqlite:///data/reflexbot.db
# Example: postgresql+psycopg://reflexbot:password@localhost:5432/reflexbot
DATABASE_BUSY_TIMEOUT_MS=10000

# SCHEDULER / WATCHDOG
SIGNAL_INTERVAL_SECONDS=30
POSITION_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
WATCHDOG_INTERVAL_SECONDS=30
WATCHDOG_STALE_SECONDS=90
WATCHDOG_MAX_RESTARTS_PER_HOUR=3
WATCHDOG_STARTUP_GRACE_SECONDS=240
RUNTIME_API_ENABLED=true
# A blank Telegram token means no bot network transport is attached.
RUNTIME_TELEGRAM_ENABLED=true
RUNTIME_REGISTER_MENU=false
# Learning registers INACTIVE candidates only; no promotion/application.
RUNTIME_LEARNING_ENABLED=false
RUNTIME_LEARNING_HOUR_UTC=2
RUNTIME_REPORT_HOUR_UTC=0
RUNTIME_NOTIFICATIONS_SECONDS=30
RUNTIME_BACKUP_ENABLED=true
RUNTIME_BACKUP_HOUR_UTC=3
RUNTIME_BACKUP_KEEP=7
RUNTIME_JOB_MAX_SECONDS=120
RUNTIME_SHUTDOWN_SECONDS=120
RUNTIME_HEALTH_FILE=data/runtime/health.json
RUNTIME_LOCK_FILE=data/runtime/runtime.lock
WATCHDOG_LOCK_FILE=data/runtime/watchdog.lock

# LOGGING / LOCAL FILES
# bot.log (everything), errors.log (WARNING+) and ai_decisions.log (AI entry/trailing/config
# decisions) live in the same folder; each rotates at LOG_MAX_BYTES with LOG_BACKUP_COUNT backups
# (5 MB x 6 files by default).
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
DATA_DIR=data
BACKUP_DIR=data/backups

# Part 11 offline replay is an explicit CLI, NEVER daemon startup or stage approval.
# Keep the defaults above: DEMO_MODE=true, LIVE_TRADING=false, PAPER_TRADING=true.
# python -m scripts.smoke_backtest                         # artificial isolated prices, no credentials
# python -m scripts.backtest --manifest data/historical/manifest.json --output data/backtests/unique_run
# Default replay review=veto and simulated execution=paused; missing AI/news NEVER becomes approval.
# --simulate-orders resumes ONLY a NEW private BACKTEST ledger, not this configured production runtime.
# --review-mode synthetic_research is restricted to origin=synthetic_fixture; NEVER promotion evidence.
# ML-filtered approval replay without a causally approved BACKTEST registry is refused, not disabled.
# See docs/BACKTESTING.md and docs/OPERATOR_PLAYBOOK.md. Original signed owner initData stays private in data/.

# Part 12 diagnostics are explicit read-only commands, NEVER startup or trading approval.
# python -B -m scripts.verify_release
# python -B -m scripts.readiness --env-file .env.example
# File-only inspection ignores inherited credential/config values and reports runtime override mismatch.
# A native-target diagnostic keeps unverified Windows/session/ACL/feed/owner facts blocked.
# --inspect-sqlite-snapshot reads a MEMORY COPY only; pending WAL/journal refuses, NEVER reset/delete/checkpoint.
# See docs/READINESS.md and docs/NATIVE_VALIDATION_CHECKLIST.md. No secrets are printed or transported.
